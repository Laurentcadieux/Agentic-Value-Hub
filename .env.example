# =============================================================================
# Agentic Value Hub — environment variables
# Copy to .env for local dev; for production, supply via systemd
# EnvironmentFile or a secrets manager (see docs/SECURITY.md, docs/PRODUCTION.md).
# NEVER commit the real .env. NEVER put a secret in a NEXT_PUBLIC_* var.
# =============================================================================

# --- Database (Prisma datasource) -------------------------------------------
# Production: add &sslmode=require (or verify-full) over the WireGuard VPN.
DATABASE_URL="postgresql://avh:***@localhost:5432/agentic_value_hub?schema=public"

# --- Auth.js (NextAuth v4) ---------------------------------------------------
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public canonical URL of the deployment.
NEXTAUTH_URL="http://localhost:3000"

# --- News ingestion API ------------------------------------------------------
# Bearer token required by POST /api/v1/news. Generate with: openssl rand -base64 48
NEWS_INGEST_API_KEY="replace-with-a-secure-ingest-key"

# --- AI service layer --------------------------------------------------------
AI_PROVIDER="openai"
AI_API_KEY="replace-with-provider-api-key"
AI_MODEL="gpt-4o-mini"

# --- Rate limiting (optional; defaults shown) -------------------------------
# Per-IP sliding-window ceilings. All measured in requests per minute.
RATE_LIMIT_GLOBAL_PER_MIN=120   # middleware /api ceiling
RATE_LIMIT_HEALTH_PER_MIN=60    # /api/health
RATE_LIMIT_NEWS_PER_MIN=30       # /api/v1/news

# --- Analytics (optional, PUBLIC — non-secret only) -------------------------
# Cookieless analytics placeholder (see src/components/Analytics.tsx).
# Only measurement IDs/domains belong here; never secrets.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="agenticvaluehub.com"

# --- Monitoring (optional) ---------------------------------------------------
# Used by Uptime Kuma / external probes; the app itself does not read these.
# UPTIME_KUMA_HEALTH_URL="https://agenticvaluehub.com/api/health"

# --- Deployment runtime (set by PM2, not in .env) ---------------------------
# NODE_ENV=production
# HOSTNAME=127.0.0.1   # bind to loopback behind Nginx
# PORT=3000
