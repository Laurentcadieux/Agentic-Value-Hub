# PostgreSQL connection string (Prisma datasource URL)
DATABASE_URL="postgresql://avh:avh@localhost:5432/agentic_value_hub?schema=public"

# Auth.js (NextAuth v4) secrets
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Bearer token required by the news ingestion API
NEWS_INGEST_API_KEY="replace-with-a-secure-ingest-key"

# AI service layer
AI_PROVIDER="openai"
AI_API_KEY="replace-with-provider-api-key"
AI_MODEL="gpt-4o-mini"
